@model Analytika.Models.ViewModels.LoginViewModel
@{ Layout = null; ViewData["Title"] = "Sign in"; }
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Bix Business Intelligence</title>
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome.min.css" />
    <style>
        :root { --navy:#003b4d; --teal:#008b8b; --ink:#16313c; --muted:#526b78; --line:#d8e7ea; }
        *,*::before,*::after{box-sizing:border-box} html,body{min-height:100%}
        body{margin:0;min-width:320px;background:#edf5f6;color:var(--ink);font-family:'Inter','Segoe UI',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
        .login-shell{display:grid;grid-template-columns:minmax(300px,42%) minmax(0,1fr);min-height:100dvh}
        .brand-panel{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;gap:3rem;overflow:hidden;padding:clamp(2rem,4vw,4.5rem);color:#fff;background:radial-gradient(circle at 88% 12%,rgba(102,178,178,.34),transparent 34%),radial-gradient(circle at 4% 92%,rgba(0,139,139,.3),transparent 38%),linear-gradient(145deg,#002d3d,var(--navy) 55%,#005d68)}
        .brand-panel::after{content:'';position:absolute;z-index:-1;right:-12rem;bottom:-14rem;width:32rem;height:32rem;border:1px solid rgba(198,226,233,.16);border-radius:50%;box-shadow:0 0 0 5rem rgba(198,226,233,.025),0 0 0 10rem rgba(198,226,233,.018)}
        .brand-lockup{display:inline-flex;align-items:center;justify-content:center;width:fit-content;color:inherit;text-decoration:none}
        .brand-emblem{display:block;width:4.5rem;height:4.5rem;object-fit:contain}
        .brand-copy{max-width:34rem}.brand-copy h1{max-width:13ch;margin:0 0 1rem;color:#fff;font-family:'Sora','Inter',sans-serif;font-size:clamp(2rem,4.2vw,3.8rem);font-weight:700;letter-spacing:-.045em;line-height:1.05}.brand-copy h1 span{color:#a7ebf2}.brand-copy>p{margin:0;color:#c6dfe3;font-size:clamp(.9rem,1.3vw,1.05rem);line-height:1.7}
        .feature-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:2rem 0 0;padding:0;list-style:none}.feature-list li{display:flex;align-items:center;gap:.65rem;padding:.75rem .85rem;border:1px solid rgba(198,226,233,.16);border-radius:.75rem;background:rgba(255,255,255,.055);color:#e7f3f5;font-size:.8rem;font-weight:550}.feature-list i{width:1rem;color:#a7ebf2;text-align:center}.brand-footer{display:flex;align-items:center;gap:.65rem;color:rgba(231,243,245,.66);font-size:.75rem}.brand-footer img{width:1.7rem;height:1.7rem;object-fit:contain;opacity:.88}
        .form-panel{position:relative;display:grid;place-items:center;padding:clamp(2rem,6vw,5rem);background:radial-gradient(circle at 100% 0,rgba(102,178,178,.14),transparent 30%),#fff}
        .language-switch{position:absolute;top:clamp(1rem,2.5vw,2rem);right:clamp(1rem,3vw,2.5rem);display:inline-flex;gap:.25rem;padding:.25rem;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.9)}html[dir="rtl"] .language-switch{right:auto;left:clamp(1rem,3vw,2.5rem)}
        .language-switch button{min-width:2.5rem;min-height:2rem;border:0;border-radius:999px;background:transparent;color:var(--muted);font-size:.72rem;font-weight:700;cursor:pointer}.language-switch button.active{background:var(--navy);color:#fff}
        .language-switch button:focus-visible,.password-toggle:focus-visible,.signin-button:focus-visible,a:focus-visible{outline:3px solid rgba(0,139,139,.28);outline-offset:2px}
        .login-card{width:min(100%,27rem)}.login-card h2{margin:0;color:var(--ink);font-family:'Sora','Inter',sans-serif;font-size:clamp(1.75rem,3vw,2.2rem);font-weight:700;letter-spacing:-.035em}.subtitle{margin:.65rem 0 2rem;color:var(--muted);font-size:.92rem;line-height:1.6}.form-label{margin-bottom:.45rem;color:#294955;font-size:.78rem;font-weight:650}
        .input-shell{position:relative}.input-shell>i{position:absolute;z-index:2;top:50%;left:.95rem;width:1rem;color:#78909a;text-align:center;transform:translateY(-50%);pointer-events:none}html[dir="rtl"] .input-shell>i{right:.95rem;left:auto}
        .form-control{min-height:3rem;padding:.75rem 3rem .75rem 2.8rem;border:1px solid var(--line);border-radius:.75rem;background:#f9fbfb;color:var(--ink);font-size:.9rem}html[dir="rtl"] .form-control{padding-right:2.8rem;padding-left:3rem}.form-control:focus{border-color:var(--teal);background:#fff;box-shadow:0 0 0 .22rem rgba(0,139,139,.11)}.form-control::placeholder{color:#91a4ac}
        .password-toggle{position:absolute;z-index:2;top:50%;right:.55rem;display:grid;place-items:center;width:2.25rem;height:2.25rem;border:0;border-radius:.55rem;background:transparent;color:#718892;transform:translateY(-50%);cursor:pointer}html[dir="rtl"] .password-toggle{right:auto;left:.55rem}.password-toggle:hover{background:#eaf3f4;color:var(--navy)}
        .form-check-input:checked{border-color:var(--teal);background-color:var(--teal)}.remember-label{color:var(--muted);font-size:.82rem}
        .signin-button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;width:100%;min-height:3rem;border:0;border-radius:.75rem;background:linear-gradient(135deg,var(--navy),#006884);box-shadow:0 .7rem 1.6rem rgba(0,59,77,.17);color:#fff;font-size:.9rem;font-weight:700;cursor:pointer;transition:transform .16s,box-shadow .16s}.signin-button:hover{transform:translateY(-1px);box-shadow:0 .9rem 2rem rgba(0,59,77,.22)}.signin-button:active{transform:none}
        .login-alert{margin-bottom:1.25rem;border:1px solid #f3c7cb;border-radius:.75rem;background:#fff4f5;color:#8c2630;font-size:.82rem}.mobile-brand{display:none;margin:0 auto 2rem}.form-footer{margin:2rem 0 0;color:#78909a;font-size:.72rem;text-align:center}
        @@media(max-width:900px){.login-shell{grid-template-columns:minmax(260px,38%) minmax(0,1fr)}.brand-panel{padding:2rem}.feature-list{grid-template-columns:1fr}}
        @@media(max-width:700px){.login-shell{display:block}.brand-panel{display:none}.form-panel{min-height:100dvh;padding:5.5rem 1.25rem 2rem}.mobile-brand{display:inline-flex}}
        @@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:.01ms!important}}
    </style>
</head>
