@model Analytika.Models.ViewModels.LoginViewModel
@{ Layout = null; ViewData["Title"] = "Sign in"; }
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — BIX Revenue Intelligence</title>
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome.min.css" />
    <style>
        :root{--ink:#071518;--ink-2:#0b2024;--paper:#edf7f3;--muted:#8ea49e;--teal:#48e0be;--lime:#d1fa54;--line:rgba(224,250,242,.15);--danger:#ff8b80}
        *,*::before,*::after{box-sizing:border-box}html,body{min-height:100%}
        body{margin:0;min-width:320px;background:var(--ink);color:var(--paper);font-family:Inter,"Segoe UI",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
        .login-shell{display:grid;grid-template-columns:minmax(380px,1.05fr) minmax(430px,.95fr);min-height:100dvh;background:radial-gradient(circle at 18% 72%,rgba(72,224,190,.11),transparent 28%),var(--ink)}
        .brand-panel{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;padding:clamp(2rem,5vw,5.5rem);border-right:1px solid var(--line)}
        .brand-panel::before{content:"";position:absolute;z-index:-1;right:-11rem;top:16%;width:31rem;height:31rem;border:1px solid rgba(72,224,190,.16);border-radius:50%;box-shadow:0 0 0 5rem rgba(72,224,190,.025),0 0 0 10rem rgba(209,250,84,.018)}
        .brand-lockup{display:inline-flex;align-items:center;width:fit-content;color:inherit;text-decoration:none}
        .brand-emblem{display:block;width:4.5rem;height:4.5rem;object-fit:contain;filter:drop-shadow(0 0 24px rgba(72,224,190,.18))}
        .brand-copy{position:relative;max-width:38rem}.brand-copy::before{content:"HEALTHCARE REVENUE INTELLIGENCE";display:block;margin-bottom:1.4rem;color:var(--teal);font-size:.7rem;font-weight:800;letter-spacing:.16em}
        .brand-copy h1{max-width:12ch;margin:0 0 1.3rem;color:#f2faf7;font-size:clamp(2.8rem,5vw,5.5rem);font-weight:850;letter-spacing:-.07em;line-height:.91}.brand-copy h1 span{color:var(--lime)}
        .brand-copy>p{max-width:36rem;margin:0;color:#a8bbb6;font-size:clamp(.95rem,1.2vw,1.08rem);line-height:1.7}
        .feature-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:2rem 0 0;padding:0;list-style:none}.feature-list li{display:flex;align-items:center;gap:.65rem;padding:.82rem .9rem;border:1px solid var(--line);border-radius:.8rem;background:rgba(255,255,255,.025);color:#dcece7;font-size:.78rem;font-weight:650}.feature-list i{width:1rem;color:var(--teal);text-align:center}
        .brand-footer{display:flex;align-items:center;gap:.7rem;color:#748b85;font-size:.72rem}.brand-footer img{width:1.8rem;height:1.8rem;object-fit:contain}
        .form-panel{position:relative;display:grid;place-items:center;padding:clamp(2rem,6vw,6rem);background:linear-gradient(145deg,#eef8f4,#dcece6)}
        .form-panel::after{content:"";position:absolute;inset:20px;border:1px solid rgba(7,21,24,.06);border-radius:22px;pointer-events:none}
        .language-switch{position:absolute;z-index:2;top:clamp(1.4rem,3vw,2.5rem);right:clamp(1.4rem,3vw,2.5rem);display:inline-flex;gap:.2rem;padding:.24rem;border:1px solid rgba(7,21,24,.12);border-radius:999px;background:rgba(255,255,255,.58);backdrop-filter:blur(8px)}html[dir="rtl"] .language-switch{right:auto;left:clamp(1.4rem,3vw,2.5rem)}
        .language-switch button{min-width:2.7rem;min-height:2.1rem;border:0;border-radius:999px;background:transparent;color:#536963;font-size:.72rem;font-weight:800;cursor:pointer}.language-switch button.active{background:var(--ink);color:var(--paper)}
        .language-switch button:focus-visible,.password-toggle:focus-visible,.signin-button:focus-visible,a:focus-visible{outline:3px solid rgba(72,224,190,.45);outline-offset:3px}
        .login-card{position:relative;z-index:1;width:min(100%,29rem);padding:clamp(1.8rem,4vw,3rem);border:1px solid rgba(7,21,24,.1);border-radius:1.35rem;background:rgba(255,255,255,.82);box-shadow:0 32px 80px rgba(7,21,24,.12);backdrop-filter:blur(14px)}
        .login-card::before{content:"SECURE WORKSPACE";display:block;margin-bottom:1rem;color:#087b68;font-size:.66rem;font-weight:850;letter-spacing:.15em}
        .login-card h2{margin:0;color:var(--ink);font-size:clamp(2rem,3vw,2.7rem);font-weight:850;letter-spacing:-.055em}.subtitle{margin:.65rem 0 2rem;color:#526a64;font-size:.9rem;line-height:1.6}.form-label{margin-bottom:.45rem;color:#29433d;font-size:.78rem;font-weight:750}
        .input-shell{position:relative}.input-shell>i{position:absolute;z-index:2;top:50%;left:1rem;width:1rem;color:#718a83;text-align:center;transform:translateY(-50%);pointer-events:none}html[dir="rtl"] .input-shell>i{right:1rem;left:auto}
        .form-control{min-height:3.25rem;padding:.78rem 3rem .78rem 2.9rem;border:1px solid #cdded8;border-radius:.78rem;background:#f8fbfa;color:var(--ink);font-size:.9rem}html[dir="rtl"] .form-control{padding-right:2.9rem;padding-left:3rem}.form-control:focus{border-color:#087b68;background:#fff;box-shadow:0 0 0 .22rem rgba(72,224,190,.17)}.form-control::placeholder{color:#91a39e}
        .password-toggle{position:absolute;z-index:2;top:50%;right:.58rem;display:grid;place-items:center;width:2.25rem;height:2.25rem;border:0;border-radius:.55rem;background:transparent;color:#718a83;transform:translateY(-50%);cursor:pointer}html[dir="rtl"] .password-toggle{right:auto;left:.58rem}.password-toggle:hover{background:#e4efeb;color:var(--ink)}
        .form-check-input:checked{border-color:#087b68;background-color:#087b68}.remember-label{color:#536963;font-size:.8rem}.text-danger{color:#a93632!important}
        .signin-button{display:inline-flex;align-items:center;justify-content:space-between;width:100%;min-height:3.3rem;padding:0 1.15rem;border:0;border-radius:.8rem;background:var(--lime);box-shadow:0 .8rem 1.7rem rgba(109,136,20,.16);color:var(--ink);font-size:.9rem;font-weight:850;cursor:pointer;transition:transform .16s,box-shadow .16s}.signin-button:hover{transform:translateY(-2px);box-shadow:0 1rem 2rem rgba(70,92,10,.2)}.signin-button:active{transform:none}
        .login-alert{margin-bottom:1.25rem;border:1px solid #efbbb6;border-radius:.75rem;background:#fff2f0;color:#8d2924;font-size:.82rem}.mobile-brand{display:none;margin:0 auto 2rem}.form-footer{margin:1.7rem 0 0;color:#718680;font-size:.7rem;text-align:center}
        .back-home{position:absolute;z-index:2;left:clamp(1.4rem,3vw,2.5rem);top:clamp(1.4rem,3vw,2.5rem);color:#405953;font-size:.76rem;font-weight:750;text-decoration:none}.back-home:hover{color:#087b68}html[dir="rtl"] .back-home{left:auto;right:clamp(1.4rem,3vw,2.5rem)}
        @@media(max-width:900px){.login-shell{grid-template-columns:minmax(290px,40%) minmax(0,1fr)}.brand-panel{padding:2.2rem}.feature-list{grid-template-columns:1fr}.brand-copy h1{font-size:clamp(2.5rem,5vw,4rem)}}
        @@media(max-width:700px){.login-shell{display:block;background:#e7f2ee}.brand-panel{display:none}.form-panel{min-height:100dvh;padding:6rem 1.1rem 2rem}.form-panel::after{inset:10px}.mobile-brand{display:flex}.login-card{padding:1.7rem}.back-home{top:1.5rem;left:1.35rem}html[dir="rtl"] .back-home{right:1.35rem;left:auto}.language-switch{top:1.15rem;right:1.15rem}html[dir="rtl"] .language-switch{left:1.15rem;right:auto}}
        @@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:.01ms!important}}
    </style>
</head>
<body>
<main class="login-shell">
    <section class="brand-panel" aria-label="Bix Business Intelligence">
        <a class="brand-lockup" href="/" aria-label="Ghaf home"><img class="brand-emblem" src="~/images/brand/ghaf-emblem-centred.png" alt="" /></a>
        <div class="brand-copy">
            <h1>See the leak. <span>Recover the revenue.</span></h1>
            <p>One focused workspace for claims, remittance, denials and revenue-cycle action across every facility.</p>
            <ul class="feature-list">
                <li><i class="fas fa-chart-line" aria-hidden="true"></i>Revenue command center</li>
                <li><i class="fas fa-cloud-download-alt" aria-hidden="true"></i>Remittance intelligence</li>
                <li><i class="fas fa-file-invoice" aria-hidden="true"></i>Denial action</li>
                <li><i class="fas fa-building" aria-hidden="true"></i>Multi-facility visibility</li>
            </ul>
        </div>
        <div class="brand-footer"><img src="~/images/brand/ghaf-emblem-centred.png" alt=""/><span>&copy; @DateTime.Now.Year Ghaf Bi Solutions</span></div>
    </section>
    <section class="form-panel" aria-labelledby="loginTitle">\n        <a class="back-home" href="/">← Back to BIX</a>
        <div class="language-switch" role="group" aria-label="Language">
            <button type="button" class="active" data-language="en" aria-pressed="true">EN</button>
            <button type="button" data-language="ar" aria-pressed="false">AR</button>
        </div>
        <div class="login-card">
            <a class="brand-lockup mobile-brand" href="/" aria-label="Ghaf home"><img class="brand-emblem" src="~/images/brand/ghaf-emblem-centred.png" alt="" /></a>
            <h2 id="loginTitle" data-i18n="welcome">Welcome back</h2>
            <p class="subtitle" data-i18n="subtitle">Sign in to continue to your revenue intelligence workspace.</p>
            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid) { <div class="alert login-alert" role="alert"><i class="fas fa-circle-exclamation me-2" aria-hidden="true"></i><span data-i18n="error">The email or password is incorrect. Please try again.</span></div> }
                <div class="mb-3">
                    <label asp-for="Email" class="form-label" data-i18n="email">Email address</label>
                    <div class="input-shell"><i class="fas fa-envelope" aria-hidden="true"></i><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="username" inputmode="email" autofocus /></div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label" data-i18n="password">Password</label>
                    <div class="input-shell"><i class="fas fa-lock" aria-hidden="true"></i><input asp-for="Password" id="passwordInput" class="form-control" placeholder="Enter your password" autocomplete="current-password"/><button type="button" class="password-toggle" id="passwordToggle" aria-label="Show password" aria-pressed="false"><i class="fas fa-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check d-flex align-items-center gap-2 mb-4"><input asp-for="RememberMe" class="form-check-input mt-0"/><label asp-for="RememberMe" class="form-check-label remember-label" data-i18n="remember">Keep me signed in</label></div>
                <button type="submit" class="signin-button"><span data-i18n="signin">Sign in</span><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </form>
            <p class="form-footer">Secure access for authorised Ghaf Business Intelligence users.</p>
        </div>
    </section>
</main>
<script>
(function(){
    const text={en:{welcome:'Welcome back',subtitle:'Sign in to continue to your revenue intelligence workspace.',email:'Email address',password:'Password',remember:'Keep me signed in',signin:'Sign in',error:'The email or password is incorrect. Please try again.'},ar:{welcome:'أهلاً بعودتك',subtitle:'سجّل الدخول للمتابعة إلى مساحة معلومات دورة الإيرادات.',email:'البريد الإلكتروني',password:'كلمة المرور',remember:'ابقَ مسجلاً للدخول',signin:'تسجيل الدخول',error:'البريد الإلكتروني أو كلمة المرور غير صحيحة. حاول مرة أخرى.'}};
    const buttons=document.querySelectorAll('[data-language]'),input=document.getElementById('passwordInput'),toggle=document.getElementById('passwordToggle');
    function apply(lang){lang=text[lang]?lang:'en';document.documentElement.lang=lang;document.documentElement.dir=lang==='ar'?'rtl':'ltr';document.querySelectorAll('[data-i18n]').forEach(el=>{const value=text[lang][el.dataset.i18n];if(value)el.textContent=value});buttons.forEach(btn=>{const active=btn.dataset.language===lang;btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',active?'true':'false')});try{localStorage.setItem('analytika-lang',lang)}catch(_){}}
    buttons.forEach(btn=>btn.addEventListener('click',()=>apply(btn.dataset.language)));
    toggle.addEventListener('click',()=>{const reveal=input.type==='password';input.type=reveal?'text':'password';toggle.setAttribute('aria-pressed',reveal?'true':'false');toggle.setAttribute('aria-label',reveal?'Hide password':'Show password');toggle.querySelector('i').className=reveal?'fas fa-eye-slash':'fas fa-eye';input.focus()});
    let saved='en';try{saved=localStorage.getItem('analytika-lang')||'en'}catch(_){}apply(saved);
})();
</script>
</body>
</html>
